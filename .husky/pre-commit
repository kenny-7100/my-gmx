#!/bin/sh
set -e
. "$(dirname "$0")/_/husky.sh"

# Personal infrastructure has no application build inputs. Mixed changes use the full upstream path.
if node scripts/agent-infrastructure-scope.mjs; then
  git diff --cached --check
  exit 0
fi

# Step 1: Start independent tasks in parallel
yarn lingui:prepare &
LINGUI_PID=$!

yarn build-sdk &
BUILD_PID=$!

# Step 2: Wait for build-sdk — lint-staged and tscheck depend on it
wait $BUILD_PID

# Step 3: Start dependent tasks in parallel
yarn tscheck &
TSCHECK_PID=$!

yarn lint-staged &
LINT_PID=$!

# Step 4: Wait for all remaining tasks
wait $LINGUI_PID
wait $LINT_PID
wait $TSCHECK_PID

# Step 5: Stage generated locale files
git add src/locales/

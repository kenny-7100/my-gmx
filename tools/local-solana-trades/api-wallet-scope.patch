diff --git a/src/domain/solana/localIndexScope.test.ts b/src/domain/solana/localIndexScope.test.ts
new file mode 100644
index 0000000..6677315
--- /dev/null
+++ b/src/domain/solana/localIndexScope.test.ts
@@ -0,0 +1,35 @@
+import type { Knex } from "knex";
+
+import { SolanaIndexStore } from "./indexStore";
+import { getLocalIndexWallet } from "./localIndexScope";
+
+const wallet = "25atW95AGV61h7oDwfW5HtFjUB4q2ctAP6s5z4NcUjbU";
+
+it("requires explicit development scope and preserves the unscoped default TRD-136", () => {
+  expect(getLocalIndexWallet({ NODE_ENV: "production" })).toBeUndefined();
+  expect(getLocalIndexWallet({ NODE_ENV: "development", TRD136_INDEX_WALLET: wallet })).toBe(wallet);
+  for (const NODE_ENV of [undefined, "test", "production"]) {
+    expect(() => getLocalIndexWallet({ NODE_ENV, TRD136_INDEX_WALLET: wallet })).toThrow();
+  }
+  for (const TRD136_INDEX_WALLET of ["", "invalid", ` ${wallet}`]) {
+    expect(() => getLocalIndexWallet({ NODE_ENV: "development", TRD136_INDEX_WALLET })).toThrow();
+  }
+});
+
+it("rejects out-of-scope reads and writes before accessing the database TRD-136", async () => {
+  const db = jest.fn() as unknown as Knex;
+  const index = new SolanaIndexStore(db, "local-wallet", wallet);
+  await expect(index.read("11111111111111111111111111111112")).rejects.toThrow("outside");
+  await expect(
+    index.publish(
+      { writer: "writer", fence: "1" },
+      {
+        slot: 1,
+        readAt: Date.now(),
+        snapshot: {} as never,
+        accounts: [{ address: "account", wallet: "other", kind: "user", data: Buffer.alloc(0), slot: 1 }],
+      }
+    )
+  ).rejects.toThrow("outside");
+  expect(db).not.toHaveBeenCalled();
+});
diff --git a/src/domain/solana/localIndexScope.ts b/src/domain/solana/localIndexScope.ts
new file mode 100644
index 0000000..cc18647
--- /dev/null
+++ b/src/domain/solana/localIndexScope.ts
@@ -0,0 +1,15 @@
+import { decodePubkey } from "@/lib/solana";
+
+// Local TRD-136 experiment only. This does not repair or replace the global index.
+export function getLocalIndexWallet(env: NodeJS.ProcessEnv = process.env): string | undefined {
+  const wallet = env.TRD136_INDEX_WALLET;
+  if (wallet === undefined) {
+    return undefined;
+  }
+  if (env.NODE_ENV !== "development" || !decodePubkey(wallet)) {
+    throw new Error("TRD136_INDEX_WALLET requires development mode and a valid Solana public key");
+  }
+  return wallet;
+}
+
+export const localIndexWallet = getLocalIndexWallet();
